ENVIRONMENT=dev
LOG_LEVEL=DEBUG

POSTGRES_USER=smartbarrel
POSTGRES_PASSWORD=smartbarrel-dev
POSTGRES_DB=smartbarrel_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

JWT_PUBLIC_KEY_PATH=/etc/jwt/public.pem
JWT_PRIVATE_KEY_PATH=/etc/jwt/private.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=smartbarrel-auth
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@smartbarrel.td

# Object storage (MinIO in dev, S3 in prod)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
STORAGE_BACKEND=s3
S3_BUCKET=smartbarrel-attachments
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
